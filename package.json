{
  "name": "bookeaseapp",
  "version": "1.1.0",
  "main": "index.js",
  "react-native": "index.js",
  "description": "Privacy-First Double-Entry Bookkeeping Application",
  "author": "BookEase Team",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop": "electron electron/main.js",
    "electron:dev": "electron electron/main.js",
    "build:desktop": "npx expo export -p web && npx electron-builder --win"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.27",
    "expo-asset": "~12.0.10",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.19",
    "expo-font": "~14.0.9",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.22.5",
    "@types/react": "~19.1.10",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2"
  },
  "license": "Apache-2.0",
  "private": true,
  "build": {
    "appId": "com.bookease.app",
    "productName": "BookEase",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}